{
  "$defs": {
    "_Delta": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "basis_ids": {
          "items": {
            "type": "string"
          },
          "title": "Basis Ids",
          "type": "array"
        },
        "new_canonical_json": {
          "title": "New Canonical Json",
          "type": "string"
        },
        "old_canonical_json": {
          "title": "Old Canonical Json",
          "type": "string"
        },
        "pointer": {
          "title": "Pointer",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "pointer",
        "old_canonical_json",
        "new_canonical_json",
        "reason",
        "basis_ids"
      ],
      "title": "_Delta",
      "type": "object"
    },
    "_File": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "byte_count": {
          "exclusiveMinimum": 0,
          "title": "Byte Count",
          "type": "integer"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "name",
        "sha256",
        "byte_count"
      ],
      "title": "_File",
      "type": "object"
    },
    "_Material": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "annotation_id": {
          "title": "Annotation Id",
          "type": "string"
        },
        "basis_ids": {
          "items": {
            "type": "string"
          },
          "title": "Basis Ids",
          "type": "array"
        },
        "material_type": {
          "enum": [
            "quotation",
            "original prose",
            "lexical paraphrase",
            "morphology-derived statement",
            "citation/notice"
          ],
          "title": "Material Type",
          "type": "string"
        },
        "pointer": {
          "title": "Pointer",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "result": {
          "const": "supported",
          "title": "Result",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "annotation_id",
        "pointer",
        "text",
        "material_type",
        "basis_ids",
        "reason",
        "result"
      ],
      "title": "_Material",
      "type": "object"
    },
    "_Note": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "annotation_issue_id": {
          "title": "Annotation Issue Id",
          "type": "string"
        },
        "annotation_revision": {
          "const": 2,
          "title": "Annotation Revision",
          "type": "integer"
        },
        "notes_git_blob": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Notes Git Blob",
          "type": "string"
        },
        "notes_original_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Notes Original Sha256",
          "type": "string"
        },
        "reader_annotation_projection_revision": {
          "const": 2,
          "title": "Reader Annotation Projection Revision",
          "type": "integer"
        }
      },
      "required": [
        "annotation_issue_id",
        "annotation_revision",
        "reader_annotation_projection_revision",
        "notes_git_blob",
        "notes_original_sha256"
      ],
      "title": "_Note",
      "type": "object"
    },
    "_Right": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "basis_id": {
          "title": "Basis Id",
          "type": "string"
        },
        "components": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              }
            ],
            "type": "array"
          },
          "title": "Components",
          "type": "array"
        },
        "fulfillment": {
          "items": {
            "type": "string"
          },
          "title": "Fulfillment",
          "type": "array"
        },
        "grant": {
          "title": "Grant",
          "type": "string"
        },
        "obligations": {
          "items": {
            "type": "string"
          },
          "title": "Obligations",
          "type": "array"
        },
        "permission_evidence": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              }
            ],
            "type": "array"
          },
          "title": "Permission Evidence",
          "type": "array"
        },
        "reciprocal_assessment": {
          "title": "Reciprocal Assessment",
          "type": "string"
        },
        "result": {
          "const": "supported",
          "title": "Result",
          "type": "string"
        },
        "snapshot_identity": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Snapshot Identity",
          "type": "string"
        },
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "source_version": {
          "title": "Source Version",
          "type": "string"
        }
      },
      "required": [
        "basis_id",
        "source_id",
        "source_version",
        "snapshot_identity",
        "components",
        "permission_evidence",
        "grant",
        "obligations",
        "fulfillment",
        "reciprocal_assessment",
        "result"
      ],
      "title": "_Right",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
