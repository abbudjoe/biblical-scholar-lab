        },
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "minLength": 1,
          "type": "string"
        }
      ],
      "title": "Publication Paths",
      "type": "array"
    },
    "published": {
      "title": "Published",
      "type": "boolean"
    },
    "receipt_identity": {
      "format": "uuid",
