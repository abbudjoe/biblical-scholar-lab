{
  "$defs": {
    "ArchiveCandidate": {
      "additionalProperties": false,
      "properties": {
        "encrypted": {"anyOf": [{"type": "boolean"}, {"type": "null"}], "title": "Encrypted"},
        "filesystem": {"anyOf": [{"type": "string"}, {"type": "null"}], "title": "Filesystem"},
        "free_bytes": {"anyOf": [{"minimum": 0, "type": "integer"}, {"type": "null"}], "title": "Free Bytes"},
        "internal": {"anyOf": [{"type": "boolean"}, {"type": "null"}], "title": "Internal"},
        "mounted": {"title": "Mounted", "type": "boolean"},
        "parent_physical_device": {"anyOf": [{"type": "string"}, {"type": "null"}], "title": "Parent Physical Device"},
        "read_only": {"anyOf": [{"type": "boolean"}, {"type": "null"}], "title": "Read Only"},
        "thunderbolt_evidenced": {"title": "Thunderbolt Evidenced", "type": "boolean"},
        "volume_uuid": {"anyOf": [{"type": "string"}, {"type": "null"}], "title": "Volume Uuid"}
      },
      "required": [
        "filesystem",
        "encrypted",
        "internal",
        "mounted",
        "read_only",
        "volume_uuid",
        "parent_physical_device",
        "free_bytes",
        "thunderbolt_evidenced"
      ],
      "title": "ArchiveCandidate",
      "type": "object"
    },
    "ArchiveReadiness": {
      "enum": [
        "CANDIDATE_READY_FOR_OWNER_APPROVAL",
        "VOLUME_NOT_FOUND",
        "AMBIGUOUS_VOLUME",
        "NOT_APFS",
        "NOT_ENCRYPTED",
        "NOT_EXTERNAL",
        "IDENTITY_INCOMPLETE",
        "INSUFFICIENT_SPACE",
        "READ_ONLY",
        "UNSUPPORTED_HOST",
        "INSPECTION_FAILED"
      ],
      "title": "ArchiveReadiness",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "candidate": {"anyOf": [{"$ref": "#/$defs/ArchiveCandidate"}, {"type": "null"}]},
    "candidate_count": {"minimum": 0, "title": "Candidate Count", "type": "integer"},
    "contract": {
      "const": "ArchivePreflightReceipt",
      "default": "ArchivePreflightReceipt",
      "title": "Contract",
      "type": "string"
    },
    "generated_at": {"format": "date-time", "title": "Generated At", "type": "string"},
    "readiness": {"$ref": "#/$defs/ArchiveReadiness"},
    "reasons": {"items": {"type": "string"}, "title": "Reasons", "type": "array"},
    "receipt_id": {"format": "uuid", "title": "Receipt Id", "type": "string"},
    "requested_volume_name": {"minLength": 1, "title": "Requested Volume Name", "type": "string"},
    "schema_version": {"const": "1.0", "default": "1.0", "title": "Schema Version", "type": "string"}
  },
  "required": [
    "receipt_id",
    "generated_at",
    "requested_volume_name",
    "readiness",
    "reasons",
    "candidate_count",
    "candidate"
  ],
  "title": "ArchivePreflightReceipt",
  "type": "object"
}
