{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "token": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9_.:@/-]*$", "maxLength": 160},
    "path": {"type": "string", "pattern": "^[A-Za-z0-9._/-]+$", "maxLength": 240},
    "utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "paths": {"type": "array", "items": {"$ref": "#/$defs/path"}, "uniqueItems": true},
    "file": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {
      "path": {"$ref": "#/$defs/path"}, "sha256": {"$ref": "#/$defs/hash"}}},
    "measured": {"type": "object", "minProperties": 13, "maxProperties": 13,
      "propertyNames": {"enum": ["substantive_lines_total", "production_loc_added", "production_loc_removed",
        "test_loc_added", "test_loc_removed", "production_files", "public_contracts", "workflows", "migrations",
        "module_nonblank_lines", "maximum_function_lines", "maximum_cyclomatic_complexity",
        "maximum_observed_line_length"]},
      "additionalProperties": {"type": "integer", "minimum": 0}},
    "change": {"type": "object", "additionalProperties": false, "required": ["kind", "reason", "path"],
      "properties": {"kind": {"enum": ["ADD", "MODIFY", "DELETE"]}, "reason": {"$ref": "#/$defs/token"},
        "path": {"$ref": "#/$defs/path"}}},
    "command": {"type": "object", "additionalProperties": false, "required": [
        "command_index", "evidence_id", "root_turn_id", "activation_id",
        "implementation_head_sha", "argv", "working_directory", "started_at_utc", "finished_at_utc",
        "exit_code", "stdout", "stderr", "receipt", "execution_evidence_level"],
      "properties": {
        "command_index": {"type": "integer", "minimum": 1}, "evidence_id": {"$ref": "#/$defs/token"},
        "root_turn_id": {"$ref": "#/$defs/token"}, "activation_id": {"const": "ACT-W00-REPOSITORY-GOVERNANCE-v3"},
        "implementation_head_sha": {"$ref": "#/$defs/sha"},
        "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "maxLength": 240}},
        "working_directory": {"const": "."}, "started_at_utc": {"$ref": "#/$defs/utc"},
        "finished_at_utc": {"$ref": "#/$defs/utc"}, "exit_code": {"const": 0},
        "stdout": {"$ref": "#/$defs/file"}, "stderr": {"$ref": "#/$defs/file"},
        "receipt": {"$ref": "#/$defs/file"}, "execution_evidence_level": {"const": "LOCAL_CAPTURED"}}},
    "finding": {"type": "object", "additionalProperties": false,
      "required": ["finding_id", "severity", "status", "evidence", "rationale"], "properties": {
        "finding_id": {"$ref": "#/$defs/token"},
        "severity": {"enum": ["P0", "P1", "P2", "P3"]}, "status": {"enum": ["CLOSED", "UNRESOLVED"]},
        "evidence": {"$ref": "#/$defs/token"}, "rationale": {"$ref": "#/$defs/token"}}},
    "review": {"type": "object", "additionalProperties": false, "required": [
        "review_run_id", "reviewer_revision_or_exact_model_identity",
        "reasoning_effort", "base_sha", "implementation_head_sha", "implementation_tree_sha",
        "diff_sha256", "review_instruction", "artifacts_inspected", "findings",
        "conclusion", "started_at_utc", "completed_at_utc"],
      "properties": {"review_run_id": {"$ref": "#/$defs/token"}, "reasoning_effort": {"const": "MAXIMUM"},
        "reviewer_revision_or_exact_model_identity": {"const": "GPT_5_6_SOL"},
        "base_sha": {"$ref": "#/$defs/sha"}, "implementation_head_sha": {"$ref": "#/$defs/sha"},
        "implementation_tree_sha": {"$ref": "#/$defs/sha"}, "diff_sha256": {"$ref": "#/$defs/hash"},
        "review_instruction": {"$ref": "#/$defs/file"},
        "artifacts_inspected": {"$ref": "#/$defs/paths"}, "conclusion": {"const": "CLEAN"},
        "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
        "started_at_utc": {"$ref": "#/$defs/utc"}, "completed_at_utc": {"$ref": "#/$defs/utc"}}}},
  "type": "object", "additionalProperties": false, "required": [
    "schema_version", "root_turn_id", "activation_id", "split_id", "status",
    "implementation_state", "repository", "branch", "pr_url", "starting_live_sha", "base_sha",
    "implementation_head_sha", "started_at_utc", "completed_at_utc", "scope",
    "changes", "integrity", "commands", "artifacts", "complexity_receipt", "dependencies",
    "github_auth", "independent_review", "known_limitations", "terminal_state", "next_required_action"],
  "properties": {
    "schema_version": {"const": "bsl.w00a1a-handoff.v1"}, "root_turn_id": {"$ref": "#/$defs/token"},
    "activation_id": {"const": "ACT-W00-REPOSITORY-GOVERNANCE-v3"},
    "split_id": {"const": "W00A1A_REPAIR05"},
    "status": {"const": "READY_FOR_CHATGPT_REVIEW"}, "repository": {"const": "abbudjoe/biblical-scholar-lab"},
    "implementation_state": {"const": "CANDIDATE_PENDING_CHATGPT_AND_OWNER_APPROVAL"},
    "branch": {"type": "string", "pattern": "^codex/[A-Za-z0-9._/-]+$"},
    "pr_url": {"type": "string", "pattern": "^https://github\\.com/abbudjoe/biblical-scholar-lab/pull/[1-9][0-9]*$"},
    "starting_live_sha": {"const": "20c2755bd5be2b080f78a9529792c83f0cd9c400"}, "base_sha": {"$ref": "#/$defs/sha"},
    "implementation_head_sha": {"$ref": "#/$defs/sha"},
    "started_at_utc": {"$ref": "#/$defs/utc"}, "completed_at_utc": {"$ref": "#/$defs/utc"},
    "scope": {"const": {"retained": [".github/workflows/governance-integrity.yml", "governance/handoff-registry.json",
        "governance/schemas/w00a1a-handoff.schema.json", "governance/test_w00_checks.py",
        "governance/w00_checks.py"], "removed": ["governance/fixtures/w00a1a-negative.json",
        "governance/fixtures/w00a1a-policy.json", "governance/fixtures/w00a1a-record.json", "governance/ruff.toml"],
        "deferred": ["W00A1B", "W00A2", "W00B", "W01"]}},
    "changes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/change"}},
    "integrity": {"type": "object", "additionalProperties": false,
      "required": ["general_schema_restored", "schema_sha256", "registry_mode", "registry_entry_count"],
      "properties": {"general_schema_restored": {"const": true}, "schema_sha256": {"$ref": "#/$defs/hash"},
        "registry_mode": {"enum": ["BOOTSTRAP", "APPEND"]},
        "registry_entry_count": {"type": "integer", "minimum": 1}}},
    "commands": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/command"}},
    "artifacts": {"type": "object", "additionalProperties": false,
      "required": ["COMPLEXITY", "BINARY_DIFF", "REVIEW_INSTRUCTION", "REVIEW_REPORT_RECORD"],
      "properties": {"COMPLEXITY": {"$ref": "#/$defs/file"}, "BINARY_DIFF": {"$ref": "#/$defs/file"},
        "REVIEW_INSTRUCTION": {"$ref": "#/$defs/file"}, "REVIEW_REPORT_RECORD": {"$ref": "#/$defs/file"}}},
    "complexity_receipt": {"type": "object", "additionalProperties": false,
      "required": ["measured", "configured", "target_excess_justification"],
      "properties": {"measured": {"$ref": "#/$defs/measured"},
        "configured": {"const": {"max_cyclomatic_complexity": 10, "max_line_length": 120, "nesting_limit": 3}},
        "target_excess_justification": {"$ref": "#/$defs/token"}}},
    "dependencies": {"const": [
      {"name": "jsonschema", "version": "4.25.1", "kind": "DIRECT_RUNTIME",
        "capability": "JSON_SCHEMA_VALIDATION", "stdlib_insufficiency": "STDLIB_LACKS_DRAFT_2020_12_VALIDATION",
        "license_maintenance": "MIT_PYPI_MAINTAINED", "alternatives": "CUSTOM_VALIDATOR_IS_MORE_COMPLEX",
        "supply_chain": "DIRECT_VERSION_PINNED_TRANSITIVE_DEPENDENCIES_RESOLVED_AT_RUN_TIME",
        "removal_strategy": "REMOVE_IF_STDLIB_SUPPORTS_DRAFT_2020_12"},
      {"name": "actions/checkout", "version": "9c091bb21b7c1c1d1991bb908d89e4e9dddfe3e0", "kind": "WORKFLOW_ACTION",
        "capability": "WORKFLOW_CHECKOUT", "stdlib_insufficiency": "GITHUB_WORKFLOW_NEEDS_ACTION",
        "license_maintenance": "MIT_GITHUB_MAINTAINED", "supply_chain": "IMMUTABLE_COMMIT_PIN",
        "alternatives": "MANUAL_FETCH_IS_MORE_COMPLEX", "removal_strategy": "REMOVE_IF_NATIVE_CHECKOUT_EXISTS"}]},
    "github_auth": {"type": "object", "additionalProperties": false,
      "required": ["auth_mode", "active_login", "hostname", "token_override_present", "token_exposed",
        "evidence_level", "command_argv", "receipt"],
      "properties": {"auth_mode": {"const": "GH_CLI_EXISTING_AUTH"}, "active_login": {"const": "abbudjoe"},
        "hostname": {"const": "github.com"}, "token_override_present": {"const": false},
        "token_exposed": {"const": false}, "receipt": {"$ref": "#/$defs/file"},
        "evidence_level": {"const": "LOCAL_SANITIZED_ASSERTION_NOT_INDEPENDENT"},
        "command_argv": {"const": ["gh", "auth", "status", "--active", "--hostname", "github.com"]}}},
    "independent_review": {"$ref": "#/$defs/review"}, "next_required_action": {"const": "CHATGPT_REVIEW"},
    "known_limitations": {"const": ["CI_CHECK_LINKS_PENDING_POST_PUSH"]},
    "terminal_state": {"const": {"merge_performed": false, "approval_submitted": false,
      "pr_remains_draft": true, "ready_transition_occurred": false, "later_phase_work_started": false,
      "source_or_benchmark_work": false, "model_or_billable_work": false}}}}
