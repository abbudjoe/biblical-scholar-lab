{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://biblical-scholar-lab.invalid/schemas/turn-handoff.schema.json",
  "title": "Biblical Scholar Lab Root-Turn Handoff",
  "$defs": {
    "text": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "texts": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "#/$defs/text" } },
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "profile": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "actor_login", "token_overrides_present"],
      "properties": {
        "kind": { "const": "LOCAL_EXISTING_GH" }, "actor_login": { "const": "abbudjoe" },
        "token_overrides_present": { "const": false }
      }
    },
    "change": {
      "type": "object", "additionalProperties": false,
      "required": ["change_id", "kind", "summary", "paths"],
      "properties": {
        "change_id": { "$ref": "#/$defs/text" }, "kind": { "enum": ["ADD", "MODIFY", "DELETE"] },
        "summary": { "$ref": "#/$defs/text" }, "paths": { "$ref": "#/$defs/texts" }
      }
    },
    "review": {
      "type": "object", "additionalProperties": false,
      "required": [
        "finding_id", "source", "severity", "affected_path_or_behavior", "root_cause", "repair",
        "regression_test", "evidence", "final_status"
      ],
      "properties": {
        "finding_id": { "$ref": "#/$defs/text" }, "source": { "$ref": "#/$defs/text" },
        "severity": { "enum": ["P0", "P1", "P2", "P3"] }, "affected_path_or_behavior": { "$ref": "#/$defs/text" },
        "root_cause": { "$ref": "#/$defs/text" }, "repair": { "$ref": "#/$defs/text" },
        "regression_test": { "$ref": "#/$defs/text" }, "evidence": { "$ref": "#/$defs/text" },
        "final_status": { "enum": ["CLOSED", "SUPERSEDED_BY_APPROVED_SPLIT", "BLOCKED_WITH_EXACT_REASON"] }
      }
    },
    "command": {
      "type": "object", "additionalProperties": false,
      "required": [
        "command_evidence_id", "root_turn_id", "activation_id", "implementation_head_sha", "argv",
        "working_directory", "execution_profile", "started_at", "finished_at", "exit_code", "result",
        "stdout_sha256", "stderr_sha256", "combined_evidence_artifact_sha256"
      ],
      "properties": {
        "command_evidence_id": { "$ref": "#/$defs/text" }, "root_turn_id": { "$ref": "#/$defs/text" },
        "activation_id": { "$ref": "#/$defs/text" }, "implementation_head_sha": { "$ref": "#/$defs/sha" },
        "argv": { "$ref": "#/$defs/texts" }, "working_directory": { "$ref": "#/$defs/text" },
        "execution_profile": { "$ref": "#/$defs/profile" }, "started_at": { "type": "string", "format": "date-time" },
        "finished_at": { "type": "string", "format": "date-time" }, "exit_code": { "type": "integer" },
        "result": { "enum": ["PASS", "FAIL"] }, "stdout_sha256": { "$ref": "#/$defs/hash" },
        "stderr_sha256": { "$ref": "#/$defs/hash" },
        "combined_evidence_artifact_sha256": { "$ref": "#/$defs/hash" }
      }
    },
    "abstraction": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "reason"],
      "properties": { "name": { "$ref": "#/$defs/text" }, "reason": { "$ref": "#/$defs/text" } }
    },
    "evaluation": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "status", "evidence"],
      "properties": {
        "name": { "$ref": "#/$defs/text" }, "evidence": { "$ref": "#/$defs/text" }, "status": { "enum": ["PASS", "FAIL"] }
      }
    },
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_id", "kind", "reference", "sha256"],
      "properties": {
        "artifact_id": { "$ref": "#/$defs/text" }, "reference": { "$ref": "#/$defs/text" },
        "kind": { "enum": ["VALIDATION_REPORT", "LIVE_RECEIPT", "REVIEW_REPORT"] }, "sha256": { "$ref": "#/$defs/hash" }
      }
    },
    "delegation": {
      "type": "object", "additionalProperties": false,
      "required": ["role", "agent", "scope", "write_performed", "result"],
      "properties": {
        "role": { "const": "READ_ONLY_REVIEWER" }, "agent": { "$ref": "#/$defs/text" },
        "scope": { "$ref": "#/$defs/text" }, "write_performed": { "const": false }, "result": { "enum": ["CLEAN", "REPAIR_REQUIRED"] }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "activation_id",
    "task_id",
    "turn_id",
    "codex_run_id",
    "status",
    "repository",
    "branch",
    "base_sha",
    "implementation_head_sha",
    "pr_url",
    "github_actor_login",
    "github_auth_mode",
    "github_auth_preflight",
    "objective",
    "acceptance_criteria",
    "design_conformance",
    "changes",
    "review_targets",
    "commands",
    "evaluations",
    "artifacts",
    "delegated_operations",
    "complexity_receipt",
    "known_risks",
    "decisions_required",
    "billable_actions",
    "next_required_action",
    "merge_performed",
    "next_task_started"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "project_id": {
      "const": "biblical-scholar-lab"
    },
    "activation_id": {
      "type": "string"
    },
    "task_id": {
      "type": "string"
    },
    "turn_id": {
      "type": "string",
      "pattern": "^W00-SOL-REPAIR03-[0-9]{8}T[0-9]{6}Z$"
    },
    "codex_run_id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "READY_FOR_CHATGPT_REVIEW",
        "BLOCKED_MISSING_EVIDENCE",
        "BLOCKED_DEPENDENCY",
        "BLOCKED_REQUIRES_DESIGN_REVIEW",
        "BLOCKED_REQUIRES_SOL_REPAIR",
        "SPLIT_REQUIRED",
        "NO_CHANGE",
        "FAILED"
      ]
    },
    "repository": {
      "type": "string"
    },
    "branch": {
      "type": "string",
      "pattern": "^codex/"
    },
    "base_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "implementation_head_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "pr_url": {
      "type": "string",
      "format": "uri"
    },
    "compare_url": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri"
    },
    "objective": {
      "type": "string"
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "design_conformance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "approved_design_ids",
        "unapproved_design_changes_executed"
      ],
      "properties": {
        "status": {
          "enum": [
            "CONFORMING",
            "DEVIATION_PROPOSED",
            "BLOCKED_REQUIRES_DESIGN_REVIEW"
          ]
        },
        "approved_design_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unapproved_design_changes_executed": {
          "const": false
        }
      }
    },
    "changes": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/change",
        "type": "object"
      }
    },
    "review_targets": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/review",
        "type": "object"
      }
    },
    "commands": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/command",
        "type": "object"
      }
    },
    "evaluations": {
      "type": "array",
      "minItems": 1, "maxItems": 64,
      "items": { "$ref": "#/$defs/evaluation" }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1, "maxItems": 64,
      "items": { "$ref": "#/$defs/artifact" }
    },
    "delegated_operations": {
      "type": "array",
      "minItems": 1, "maxItems": 64,
      "items": { "$ref": "#/$defs/delegation" }
    },
    "complexity_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "substantive_lines_total",
        "production_loc_added",
        "production_loc_removed",
        "test_loc_added",
        "test_loc_removed",
        "generated_loc",
        "production_files_added",
        "production_files_removed",
        "modules_added",
        "modules_removed",
        "tables_added",
        "migrations_added",
        "endpoints_added",
        "cli_commands_added",
        "dependencies_added",
        "dependencies_removed",
        "public_contracts_changed",
        "abstractions",
        "simpler_alternatives_considered",
        "known_duplication_or_debt",
        "waivers",
        "workflow_files",
        "external_validation_tools",
        "simplicity_conformance"
      ],
      "properties": {
        "substantive_lines_total": { "type": "integer", "minimum": 0 },
        "production_loc_added": {
          "type": "integer",
          "minimum": 0
        },
        "production_loc_removed": {
          "type": "integer",
          "minimum": 0
        },
        "test_loc_added": {
          "type": "integer",
          "minimum": 0
        },
        "test_loc_removed": {
          "type": "integer",
          "minimum": 0
        },
        "generated_loc": {
          "type": "integer",
          "minimum": 0
        },
        "production_files_added": {
          "type": "integer",
          "minimum": 0
        },
        "production_files_removed": {
          "type": "integer",
          "minimum": 0
        },
        "modules_added": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "modules_removed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tables_added": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "migrations_added": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "endpoints_added": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cli_commands_added": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dependencies_added": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dependencies_removed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "public_contracts_changed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "abstractions": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/abstraction",
            "type": "object"
          }
        },
        "simpler_alternatives_considered": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "known_duplication_or_debt": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "waivers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "workflow_files": { "$ref": "#/$defs/texts" },
        "external_validation_tools": { "$ref": "#/$defs/texts" },
        "simplicity_conformance": {
          "enum": [
            "PASS",
            "WAIVER_REQUIRED",
            "BLOCKED_REQUIRES_SPLIT",
            "BLOCKED_REQUIRES_DESIGN_REVIEW"
          ]
        }
      }
    },
    "known_risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decisions_required": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "billable_actions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "performed",
        "actual_cost_usd",
        "campaign_ids"
      ],
      "properties": {
        "performed": {
          "type": "boolean"
        },
        "actual_cost_usd": {
          "type": "number",
          "minimum": 0
        },
        "campaign_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "next_required_action": {
      "const": "CHATGPT_REVIEW"
    },
    "merge_performed": {
      "const": false
    },
    "next_task_started": {
      "const": false
    },
    "github_actor_login": {
      "const": "abbudjoe"
    },
    "github_auth_mode": {
      "const": "GH_CLI_EXISTING_AUTH"
    },
    "github_auth_preflight": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hostname",
        "active_login",
        "auth_healthy",
        "token_override_present",
        "token_exposed"
      ],
      "properties": {
        "hostname": {
          "const": "github.com"
        },
        "active_login": {
          "const": "abbudjoe"
        },
        "auth_healthy": {
          "const": true
        },
        "token_override_present": {
          "const": false
        },
        "token_exposed": {
          "const": false
        },
        "receipt_path": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
