{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://biblical-scholar-lab.invalid/schemas/turn-handoff.schema.json",
  "title": "Biblical Scholar Lab Root-Turn Handoff",
  "$defs": {
    "text": { "type": "string", "minLength": 1, "maxLength": 4096 }, "token": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9_.:/=@-]*$" },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/=@+-]*$" },
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "path": { "type": "string", "pattern": "^[A-Za-z0-9._/-]+$", "maxLength": 240 }, "utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "argv": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "#/$defs/text" } },
    "paths": { "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "$ref": "#/$defs/path" } },
    "profile": { "type": "object", "additionalProperties": false, "required": ["kind", "actor_login", "token_overrides_present"],
      "properties": { "kind": { "const": "LOCAL_EXISTING_GH" }, "actor_login": { "const": "abbudjoe" }, "token_overrides_present": { "const": false } } },
    "change": { "type": "object", "additionalProperties": false, "required": ["change_id", "kind", "paths"],
      "properties": { "change_id": { "$ref": "#/$defs/token" }, "kind": { "enum": ["ADD", "MODIFY", "DELETE"] }, "paths": { "$ref": "#/$defs/paths" } } },
    "review": { "type": "object", "additionalProperties": false, "required": ["finding_id", "severity", "final_status", "evidence_artifact_id"],
      "properties": { "finding_id": { "$ref": "#/$defs/token" }, "severity": { "enum": ["P0", "P1", "P2", "P3"] },
        "final_status": { "enum": ["CLOSED", "DEFERRED_REMOVED", "BLOCKED"] }, "evidence_artifact_id": { "$ref": "#/$defs/token" } } },
    "command": { "type": "object", "additionalProperties": false,
      "required": ["command_index", "command_evidence_id", "root_turn_id", "activation_id", "implementation_head_sha", "argv", "cwd_repo_relative", "started_at_utc", "finished_at_utc", "exit_code", "stdout_path", "stdout_sha256", "stderr_path", "stderr_sha256", "receipt_path", "receipt_sha256", "execution_profile"],
      "properties": { "command_index": { "type": "integer", "minimum": 1 }, "command_evidence_id": { "$ref": "#/$defs/token" }, "root_turn_id": { "$ref": "#/$defs/text" },
        "activation_id": { "const": "ACT-W00-REPOSITORY-GOVERNANCE-v3" }, "implementation_head_sha": { "$ref": "#/$defs/sha" }, "argv": { "$ref": "#/$defs/argv" },
        "cwd_repo_relative": { "const": "." }, "started_at_utc": { "$ref": "#/$defs/utc" }, "finished_at_utc": { "$ref": "#/$defs/utc" }, "exit_code": { "type": "integer" },
        "stdout_path": { "$ref": "#/$defs/path" }, "stdout_sha256": { "$ref": "#/$defs/hash" }, "stderr_path": { "$ref": "#/$defs/path" }, "stderr_sha256": { "$ref": "#/$defs/hash" },
        "receipt_path": { "$ref": "#/$defs/path" }, "receipt_sha256": { "$ref": "#/$defs/hash" }, "execution_profile": { "$ref": "#/$defs/profile" } } },
    "abstraction": { "type": "object", "additionalProperties": false, "required": ["name", "reason"],
      "properties": { "name": { "$ref": "#/$defs/token" }, "reason": { "$ref": "#/$defs/token" } } },
    "evaluation": { "type": "object", "additionalProperties": false, "required": ["name", "status", "evidence_artifact_id"],
      "properties": { "name": { "$ref": "#/$defs/token" }, "evidence_artifact_id": { "$ref": "#/$defs/token" }, "status": { "enum": ["PASS", "FAIL"] } } },
    "artifact": { "type": "object", "additionalProperties": false, "required": ["artifact_id", "kind", "path", "sha256"],
      "properties": { "artifact_id": { "$ref": "#/$defs/token" }, "path": { "$ref": "#/$defs/path" },
        "kind": { "enum": ["VALIDATION_REPORT", "REVIEW_REPORT"] }, "sha256": { "$ref": "#/$defs/hash" } } },
    "delegation": { "type": "object", "additionalProperties": false, "required": ["role", "agent", "scope", "write_performed", "result"],
      "properties": { "role": { "const": "READ_ONLY_REVIEWER" }, "agent": { "$ref": "#/$defs/token" }, "scope": { "$ref": "#/$defs/token" },
        "write_performed": { "const": false }, "result": { "enum": ["CLEAN", "REPAIR_REQUIRED"] } } }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "activation_id",
    "task_id",
    "turn_id",
    "codex_run_id",
    "status",
    "repository",
    "branch",
    "base_sha",
    "implementation_head_sha",
    "started_at_utc",
    "completed_at_utc",
    "pr_url",
    "compare_url",
    "github_actor_login",
    "github_auth_mode",
    "github_auth_preflight",
    "objective",
    "acceptance_criteria",
    "design_conformance",
    "changes",
    "review_targets",
    "commands",
    "evaluations",
    "artifacts",
    "delegated_operations",
    "complexity_receipt",
    "known_risks",
    "decisions_required",
    "billable_actions",
    "approval_submitted",
    "next_required_action",
    "merge_performed",
    "next_task_started"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "project_id": {
      "const": "biblical-scholar-lab"
    },
    "activation_id": {
      "type": "string"
    },
    "task_id": {
      "type": "string"
    },
    "turn_id": {
      "type": "string"
    },
    "codex_run_id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "READY_FOR_CHATGPT_REVIEW",
        "BLOCKED_MISSING_EVIDENCE",
        "BLOCKED_DEPENDENCY",
        "BLOCKED_REQUIRES_DESIGN_REVIEW",
        "BLOCKED_REQUIRES_SOL_REPAIR",
        "NO_CHANGE",
        "FAILED"
      ]
    },
    "repository": {
      "type": "string"
    },
    "branch": {
      "type": "string",
      "pattern": "^codex/"
    },
    "base_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "implementation_head_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "started_at_utc": { "$ref": "#/$defs/utc" },
    "completed_at_utc": { "$ref": "#/$defs/utc" },
    "pr_url": {
      "type": "string",
      "format": "uri"
    },
    "compare_url": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri"
    },
    "objective": {
      "type": "string"
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "design_conformance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "approved_design_ids",
        "unapproved_design_changes_executed"
      ],
      "properties": {
        "status": {
          "enum": [
            "CONFORMING",
            "DEVIATION_PROPOSED",
            "BLOCKED_REQUIRES_DESIGN_REVIEW"
          ]
        },
        "approved_design_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unapproved_design_changes_executed": {
          "const": false
        }
      }
    },
    "changes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/change" }
    },
    "review_targets": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/review" }
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/command" }
    },
    "evaluations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/evaluation" }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/artifact" }
    },
    "delegated_operations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/delegation" }
    },
    "complexity_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "substantive_lines_total",
        "production_loc_added",
        "production_loc_removed",
        "test_loc_added",
        "test_loc_removed",
        "generated_loc",
        "production_files_added",
        "production_files_removed",
        "modules_added",
        "modules_removed",
        "tables_added",
        "migrations_added",
        "endpoints_added",
        "cli_commands_added",
        "dependencies_added",
        "dependencies_removed",
        "public_contracts_changed",
        "abstractions",
        "simpler_alternatives_considered",
        "known_duplication_or_debt",
        "waivers",
        "workflow_files",
        "external_validation_tools",
        "simplicity_conformance"
      ],
      "properties": {
        "substantive_lines_total": { "type": "integer", "minimum": 0 },
        "production_loc_added": {
          "type": "integer",
          "minimum": 0
        },
        "production_loc_removed": {
          "type": "integer",
          "minimum": 0
        },
        "test_loc_added": {
          "type": "integer",
          "minimum": 0
        },
        "test_loc_removed": {
          "type": "integer",
          "minimum": 0
        },
        "generated_loc": {
          "type": "integer",
          "minimum": 0
        },
        "production_files_added": {
          "type": "integer",
          "minimum": 0
        },
        "production_files_removed": {
          "type": "integer",
          "minimum": 0
        },
        "modules_added": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "modules_removed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tables_added": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "migrations_added": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "endpoints_added": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cli_commands_added": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dependencies_added": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dependencies_removed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "public_contracts_changed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "abstractions": {
          "type": "array",
          "items": { "$ref": "#/$defs/abstraction" }
        },
        "simpler_alternatives_considered": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "known_duplication_or_debt": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "waivers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "workflow_files": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/path" } },
        "external_validation_tools": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "simplicity_conformance": {
          "enum": [
            "PASS",
            "WAIVER_REQUIRED",
            "BLOCKED_REQUIRES_SPLIT",
            "BLOCKED_REQUIRES_DESIGN_REVIEW"
          ]
        }
      }
    },
    "known_risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decisions_required": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "billable_actions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "performed",
        "actual_cost_usd"
      ],
      "properties": {
        "performed": {
          "type": "boolean"
        },
        "actual_cost_usd": {
          "type": "number",
          "minimum": 0
        },
        "campaign_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "approval_submitted": {
      "const": false
    },
    "next_required_action": {
      "const": "CHATGPT_REVIEW"
    },
    "merge_performed": {
      "const": false
    },
    "next_task_started": {
      "const": false
    },
    "github_actor_login": {
      "const": "abbudjoe"
    },
    "github_auth_mode": {
      "const": "GH_CLI_EXISTING_AUTH"
    },
    "github_auth_preflight": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hostname",
        "active_login",
        "auth_healthy",
        "token_override_present",
        "token_exposed",
        "receipt_path",
        "receipt_sha256"
      ],
      "properties": {
        "hostname": {
          "const": "github.com"
        },
        "active_login": {
          "const": "abbudjoe"
        },
        "auth_healthy": {
          "const": true
        },
        "token_override_present": {
          "const": false
        },
        "token_exposed": {
          "const": false
        },
        "receipt_path": {
          "$ref": "#/$defs/path"
        },
        "receipt_sha256": { "$ref": "#/$defs/hash" }
      }
    }
  }
}
