{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://biblical-scholar-lab.invalid/schemas/turn-handoff.schema.json",
  "title": "Biblical Scholar Lab Root-Turn Handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "activation_id",
    "task_id",
    "turn_id",
    "codex_run_id",
    "status",
    "repository",
    "branch",
    "base_sha",
    "implementation_head_sha",
    "pr_url",
    "github_actor_login",
    "github_auth_mode",
    "github_auth_preflight",
    "objective",
    "acceptance_criteria",
    "design_conformance",
    "changes",
    "review_targets",
    "commands",
    "evaluations",
    "artifacts",
    "delegated_operations",
    "complexity_receipt",
    "known_risks",
    "decisions_required",
    "billable_actions",
    "next_required_action",
    "merge_performed",
    "next_task_started"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "project_id": {
      "const": "biblical-scholar-lab"
    },
    "activation_id": {
      "type": "string"
    },
    "task_id": {
      "type": "string"
    },
    "turn_id": {
      "type": "string"
    },
    "codex_run_id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "READY_FOR_CHATGPT_REVIEW",
        "BLOCKED_MISSING_EVIDENCE",
        "BLOCKED_DEPENDENCY",
        "BLOCKED_REQUIRES_DESIGN_REVIEW",
        "BLOCKED_REQUIRES_SOL_REPAIR",
        "NO_CHANGE",
        "FAILED"
      ]
    },
    "repository": {
      "type": "string"
    },
    "branch": {
      "type": "string",
      "pattern": "^codex/"
    },
    "base_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "implementation_head_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "pr_url": {
      "type": "string",
      "format": "uri"
    },
    "compare_url": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri"
    },
    "objective": {
      "type": "string"
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "design_conformance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "approved_design_ids",
        "unapproved_design_changes_executed"
      ],
      "properties": {
        "status": {
          "enum": [
            "CONFORMING",
            "DEVIATION_PROPOSED",
            "BLOCKED_REQUIRES_DESIGN_REVIEW"
          ]
        },
        "approved_design_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unapproved_design_changes_executed": {
          "const": false
        }
      }
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "review_targets": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "evaluations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "delegated_operations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "complexity_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "production_loc_added",
        "production_loc_removed",
        "test_loc_added",
        "test_loc_removed",
        "generated_loc",
        "production_files_added",
        "production_files_removed",
        "modules_added",
        "modules_removed",
        "tables_added",
        "migrations_added",
        "endpoints_added",
        "cli_commands_added",
        "dependencies_added",
        "dependencies_removed",
        "public_contracts_changed",
        "abstractions",
        "simpler_alternatives_considered",
        "known_duplication_or_debt",
        "waivers",
        "simplicity_conformance"
      ],
      "properties": {
        "production_loc_added": {
          "type": "integer",
          "minimum": 0
        },
        "production_loc_removed": {
          "type": "integer",
          "minimum": 0
        },
        "test_loc_added": {
          "type": "integer",
          "minimum": 0
        },
        "test_loc_removed": {
          "type": "integer",
          "minimum": 0
        },
        "generated_loc": {
          "type": "integer",
          "minimum": 0
        },
        "production_files_added": {
          "type": "integer",
          "minimum": 0
        },
        "production_files_removed": {
          "type": "integer",
          "minimum": 0
        },
        "modules_added": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "modules_removed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tables_added": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "migrations_added": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "endpoints_added": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cli_commands_added": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dependencies_added": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dependencies_removed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "public_contracts_changed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "abstractions": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "simpler_alternatives_considered": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "known_duplication_or_debt": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "waivers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "simplicity_conformance": {
          "enum": [
            "PASS",
            "WAIVER_REQUIRED",
            "BLOCKED_REQUIRES_SPLIT",
            "BLOCKED_REQUIRES_DESIGN_REVIEW"
          ]
        }
      }
    },
    "known_risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decisions_required": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "billable_actions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "performed",
        "actual_cost_usd"
      ],
      "properties": {
        "performed": {
          "type": "boolean"
        },
        "actual_cost_usd": {
          "type": "number",
          "minimum": 0
        },
        "campaign_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "next_required_action": {
      "const": "CHATGPT_REVIEW"
    },
    "merge_performed": {
      "const": false
    },
    "next_task_started": {
      "const": false
    },
    "github_actor_login": {
      "const": "abbudjoe"
    },
    "github_auth_mode": {
      "const": "GH_CLI_EXISTING_AUTH"
    },
    "github_auth_preflight": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hostname",
        "active_login",
        "auth_healthy",
        "token_override_present",
        "token_exposed"
      ],
      "properties": {
        "hostname": {
          "const": "github.com"
        },
        "active_login": {
          "const": "abbudjoe"
        },
        "auth_healthy": {
          "const": true
        },
        "token_override_present": {
          "const": false
        },
        "token_exposed": {
          "const": false
        },
        "receipt_path": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
