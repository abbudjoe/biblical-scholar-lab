diff --git a/.github/workflows/governance-integrity.yml b/.github/workflows/governance-integrity.yml
new file mode 100644
index 0000000..0f9442e
--- /dev/null
+++ b/.github/workflows/governance-integrity.yml
@@ -0,0 +1,28 @@
+on: {pull_request: {branches: [main]}}
+
+permissions: {contents: read}
+
+jobs:
+  project-integrity:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@9c091bb21b7c1c1d1991bb908d89e4e9dddfe3e0
+        with: {fetch-depth: 0, persist-credentials: false}
+      - run: |
+          python3 -m pip install --disable-pip-version-check 'jsonschema==4.25.1'
+          python3 governance/w00_checks.py project-integrity \
+            --base-sha "${{ github.event.pull_request.base.sha }}" \
+            --head-sha "${{ github.event.pull_request.head.sha }}" --branch "$GITHUB_HEAD_REF"
+
+  turn-handoff-integrity:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@9c091bb21b7c1c1d1991bb908d89e4e9dddfe3e0
+        with: {fetch-depth: 0, persist-credentials: false}
+      - env: {PR_URL: "${{ github.event.pull_request.html_url }}"}
+        run: |
+          python3 -m pip install --disable-pip-version-check 'jsonschema==4.25.1'
+          python3 governance/w00_checks.py turn-handoff-integrity \
+            --base-sha "${{ github.event.pull_request.base.sha }}" \
+            --head-sha "${{ github.event.pull_request.head.sha }}" \
+            --branch "$GITHUB_HEAD_REF" --pr-url "$PR_URL"
