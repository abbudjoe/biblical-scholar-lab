{
  "name": "bsl-vs01-study-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": "24.20.0"
  },
  "scripts": {
    "build": "vite build && node scripts/build-manifest.mjs",
